# PDF files
/*.pdf
  Content-Type: application/pdf

# JavaScript — always revalidate so updates deploy immediately
/assets/js/*
  Cache-Control: no-cache

# CSS — always revalidate
/assets/css/*
  Cache-Control: no-cache

# Images and other static assets — long cache (content rarely changes)
/assets/images/*
  Cache-Control: public, max-age=31536000
/assets/guides/*
  Cache-Control: public, max-age=31536000

# HTML files
/*.html
  Cache-Control: no-cache
  Content-Type: text/html; charset=utf-8
