PORT=3001

# Comma-separated list of allowed CORS origins.
# Legacy single-value ALLOWED_ORIGIN is also accepted.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# API key for protected CRM dashboard endpoints — change before deploying!
CRM_API_KEY=change-me-before-deploy

# === RAILWAY PRODUCTION ===
# PORT is injected automatically by Railway — do not set it manually there.
# Set ALLOWED_ORIGINS in Railway environment variables to include your live domains:
# ALLOWED_ORIGINS=https://YOUR-APP.up.railway.app,https://prosperitylfs.com,https://www.prosperitylfs.com
#
# IMPORTANT — persistent volume:
# Create a Railway volume and mount it at:  /app/data
# This is where crm.db lives. Without it, the database is wiped on every redeploy.
