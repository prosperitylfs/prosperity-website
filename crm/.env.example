PORT=3001

# Comma-separated list of allowed CORS origins.
# Legacy single-value ALLOWED_ORIGIN is also accepted.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# API key for protected CRM dashboard endpoints — change before deploying!
CRM_API_KEY=change-me-before-deploy

# Cloudflare Turnstile secret key (from the Turnstile dashboard, same widget
# whose SITE_KEY is hardcoded in assets/js/main.v2.js). Required for the
# Turnstile check in routes/leads.js — submissions are rejected if unset.
TURNSTILE_SECRET_KEY=change-me-before-deploy

# Shared secret between functions/send-guide.js (Cloudflare Pages) and this
# CRM (Render). Lets routes/leads.js trust that an internal request already
# passed Turnstile, without re-checking the (already single-use) token.
# Must also be set as an env var on Cloudflare Pages with the same value.
# Never expose this in browser code.
CRM_INTERNAL_KEY=change-me-before-deploy

# Dashboard HTTP Basic Auth — protects the entire CRM UI, its static assets,
# and every API route that exposes private CRM data (contacts, calls,
# appointments, tasks, stats, SMS, email). Public routes used by external
# services (the website's lead forms, Twilio, Cal.com, /api/health) are
# unaffected and stay reachable with no credentials.
#
# Leave CRM_DASHBOARD_AUTH_ENABLED unset in local dev — the dashboard fails
# OPEN (unprotected, with a console warning) when it's unset. Only set it to
# true on Render. Once it's true, CRM_DASHBOARD_USER and
# CRM_DASHBOARD_PASSWORD become mandatory — if either is missing at that
# point, the dashboard fails CLOSED (blocks everything with a 503) rather
# than silently running unprotected.
# CRM_DASHBOARD_AUTH_ENABLED=true
# CRM_DASHBOARD_USER=change-me-before-deploy
# CRM_DASHBOARD_PASSWORD=change-me-before-deploy

# Absolute path to the SQLite database file.
# Defaults to <repo>/crm/data/crm.db when not set (local dev).
# On Render: set to /data/crm.db and mount the persistent disk at /data.
# DB_PATH=/data/crm.db

# === RENDER PRODUCTION ===
# PORT is injected automatically by Render — do not set it manually there.
# Set ALLOWED_ORIGINS to include your live domains:
# ALLOWED_ORIGINS=https://prosperitylfs.com,https://www.prosperitylfs.com,https://prosperity-website.pages.dev
#
# IMPORTANT — persistent disk:
# Add a Render disk mounted at /data (Starter plan required).
# Set DB_PATH=/data/crm.db so the database survives deploys and restarts.
